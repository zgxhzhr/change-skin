# 邮件发送配置（复制此文件为 .env 后填写真实值）
#
# QQ 邮箱示例：
#   CS_SMTP_HOST=smtp.qq.com
#   CS_SMTP_PORT=465
#   CS_SMTP_SSL=true
#   CS_SMTP_USER=你的QQ号@qq.com
#   CS_SMTP_PASSWORD=16位授权码（不是QQ登录密码）
#
# 163 邮箱：smtp.163.com:465
# Gmail：smtp.gmail.com:465（需应用专用密码）

CS_SMTP_HOST=
CS_SMTP_PORT=465
CS_SMTP_SSL=true
CS_SMTP_USER=
CS_SMTP_PASSWORD=
CS_SMTP_FROM=